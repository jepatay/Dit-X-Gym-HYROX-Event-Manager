rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read — needed for the public event page (/e/:slug)
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      // Logged-in coaches can always write. A shared checklist link (no login) may
      // only update the checklist field, and only while the event's organizer has
      // publicChecklistEnabled switched on for that event.
      allow update: if request.auth != null || (
        resource.data.publicChecklistEnabled == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist'])
      );
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      // Logged-in coaches can always write. A shared admin link (no login) may
      // only flip check-in / finish-time fields, and only while the event's
      // organizer has publicAdminEnabled switched on for that event.
      allow update: if request.auth != null || (
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.publicAdminEnabled == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt', 'finishTimeSeconds'])
      );
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else requires login
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
